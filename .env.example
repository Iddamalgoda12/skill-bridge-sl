# ─── Copy this file to .env and fill in real values ───────────────────────
# cp .env.example .env

# ─── PostgreSQL ────────────────────────────────────────────────────────────
POSTGRES_DB=skillbridgesl
POSTGRES_USER=skillbridge
POSTGRES_PASSWORD=skillbridge_secret

# ─── Spring Boot Backend ───────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=local
DB_URL=jdbc:postgresql://localhost:5432/skillbridgesl
DB_USERNAME=skillbridge
DB_PASSWORD=skillbridge_secret

# Flyway: path to migrations folder (filesystem: prefix required)
# Docker/prod → filesystem:/app/migrations  (baked into image)
# Local dev   → set automatically by application-local.yml (no need to set here)
FLYWAY_LOCATIONS=filesystem:/app/migrations

# JWT – generate a secure 256-bit base64 secret for production
JWT_SECRET=change_me_in_production_minimum_256_bits_long_random_string
JWT_EXPIRATION_MS=86400000        # 24 hours

# CORS – comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000

# ─── Next.js Frontend ──────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080/api

