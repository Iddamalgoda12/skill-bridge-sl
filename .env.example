# Optional environment values for local runs. Spring Boot does not load this
# file automatically; export values in your shell or IDE run configuration.

# ─── Spring Boot Backend ───────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=local
DB_URL=jdbc:postgresql://localhost:5432/skillbridgesl
DB_USERNAME=skillbridge
DB_PASSWORD=skillbridge_secret

# JWT signing key: base64, at least 32 bytes. REQUIRED outside the `local` profile
# (which has a development-only default). Generate one with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MS=900000            # access token: 15 minutes
JWT_REFRESH_EXPIRATION_MS=604800000 # refresh token: 7 days

# Rate limiting of login/register/contact. Only set TRUST_FORWARDED_FOR=true when the API
# is reachable solely through the Next.js server / a reverse proxy that sets X-Forwarded-For.
AUTH_RATE_LIMIT=30
TRUST_FORWARDED_FOR=false

# CORS – comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000

# ─── Next.js Frontend ──────────────────────────────────────────────────────

